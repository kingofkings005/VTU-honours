# VTU Online Account Credentials
VTU_EMAIL=your_student_email@example.com
VTU_PASSWORD=your_password

# Course Configuration
# Target course slug from URL: https://online.vtu.ac.in/student/course/1-natural-language-processing
VTU_COURSE_SLUG=1-natural-language-processing

# Manual Cookie (Optional: use this if you want to bypass login using browser session cookies)
# Format: token=... or connect.sid=... or full Cookie header value from DevTools
VTU_SESSION_COOKIE=

# Speed Mode:
# 'turbo'       -> Fast completion (directly marks video 100% completed)
# 'accelerated' -> Stepped progress (increments progress by 60s/120s every 1 second, natural simulation)
VTU_SPEED_MODE=turbo

# API Base URL (default is VTU online production)
VTU_API_BASE=https://online.vtu.ac.in/api
VTU_FRONTEND_BASE=https://online.vtu.ac.in
